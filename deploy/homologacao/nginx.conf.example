# Trocar o dominio. HTTPS deve ser configurado antes de liberar acesso.
server {
    listen 80;
    listen [::]:80;
    server_name homologacao.exemplo.org;
    root /var/www/sisamazonia/public;
    index index.php;
    charset utf-8;
    client_max_body_size 25m;

    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;

    access_log /var/log/nginx/sisamazonia-hmg-access.log;
    error_log /var/log/nginx/sisamazonia-hmg-error.log;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt { access_log off; log_not_found off; }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_read_timeout 90s;
        fastcgi_hide_header X-Powered-By;
    }

    # Nao executar uploads PHP, nem servir arquivos ocultos.
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known).* { deny all; }
}
