# Mesmo segredo persistente do Laravel; obrigatório, ASCII, 32+ caracteres sem espaços.
AI_SERVICE_TOKEN=
LLM_PROVIDER=openai
LLM_MODEL=

AI_TECHNICAL_LLM_PROVIDER=
AI_TECHNICAL_LLM_MODEL=
AI_SELECTION_LLM_PROVIDER=
AI_SELECTION_LLM_MODEL=

OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT=45
KNOWLEDGE_VERSION=
KNOWLEDGE_MAX_CHARS=50000

# Preferir credenciais no painel; estes campos são fallback legado opcional.
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
# URLs exatas separadas por vírgulas. Local: IP literal privado/loopback.
AI_LOCAL_ALLOWED_URLS=http://127.0.0.1:11434
# Custom: HTTPS, hosts de infraestrutura confiável, resolução pública obrigatória.
AI_CUSTOM_ALLOWED_URLS=
